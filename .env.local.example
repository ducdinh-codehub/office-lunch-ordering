# ── Database ───────────────────────────────────────────────────────────────────
# `pnpm db:local` starts a Postgres in .localdb/ and prints this value for you.
# Or use a hosted one, e.g. Neon: https://console.neon.tech
DATABASE_URL="postgresql://lunch@localhost:5434/lunchtime"

# ── Auth (Clerk) ───────────────────────────────────────────────────────────────
# https://dashboard.clerk.com → your app → Configure → API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# Where Clerk's widgets live in this app. Don't change these unless you move the
# routes in src/app/login and src/app/sign-up.
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/login"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/"

# ── App ────────────────────────────────────────────────────────────────────────
# Comma-separated. These accounts get access to /admin.
ADMIN_EMAILS="you@example.com"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# What the app is called — shown in the header, browser tabs and emails.
# The short name is for tight spots (header, tabs); it defaults to the full one.
# Both are built into the site: change them, then rebuild / redeploy.
NEXT_PUBLIC_APP_NAME="Lunch Time"
NEXT_PUBLIC_APP_SHORT_NAME="Lunch Time"

# ── Bank account defaults (editable later at /admin/settings) ──────────────────
# Bank code from https://api.vietqr.io/v2/banks  (e.g. VCB, TCB, MB, ACB, BIDV)
DEFAULT_BANK_CODE="VCB"
DEFAULT_BANK_ACCOUNT_NO=""
DEFAULT_BANK_ACCOUNT_NAME=""

# ── Email (optional) ───────────────────────────────────────────────────────────
# SMTP server for /admin/emails. Gmail: smtp.gmail.com, port 465, your address,
# and an App Password (Google Account → Security → 2-Step Verification → App
# passwords) — not your normal password. Resend: smtp.resend.com, port 465,
# user "resend", password = your API key.
# Leave SMTP_HOST empty in development and emails are printed to the console.
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
# Shown as the sender. Must be an address the SMTP account may send as.
EMAIL_FROM=""
# Where replies go. Defaults to the sender.
EMAIL_REPLY_TO=""
# Development safety net: when set, EVERY email goes to this address instead.
EMAIL_REDIRECT_TO=""
# Long random string; cron-job.org sends it as "Authorization: Bearer <secret>"
# to /api/cron/emails. Generate one with: openssl rand -hex 32
CRON_SECRET=""
