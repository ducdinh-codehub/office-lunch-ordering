# ── Database ───────────────────────────────────────────────────────────────────
# `pnpm db:local` starts a Postgres in .localdb/ and prints this value for you.
# Or use a hosted one, e.g. Neon: https://console.neon.tech
DATABASE_URL="postgresql://lunch@localhost:5434/lunchtime"

# ── Auth (Clerk) ───────────────────────────────────────────────────────────────
# https://dashboard.clerk.com → your app → Configure → API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# Where Clerk's widgets live in this app. Don't change these unless you move the
# routes in src/app/login and src/app/sign-up.
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/login"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/"

# ── App ────────────────────────────────────────────────────────────────────────
# Comma-separated. These accounts get access to /admin.
ADMIN_EMAILS="dinhduc4work@gmail.com"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Bank account defaults (editable later at /admin/settings) ──────────────────
# Bank code from https://api.vietqr.io/v2/banks  (e.g. VCB, TCB, MB, ACB, BIDV)
DEFAULT_BANK_CODE="VCB"
DEFAULT_BANK_ACCOUNT_NO=""
DEFAULT_BANK_ACCOUNT_NAME=""
