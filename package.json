    "cn": "^0.3.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "html-to-text": "^10.0.1",
    "lucide-react": "^1.46.0",
    "next": "15.5.25",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.0.13",
    "pg": "^8.23.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sanitize-html": "^2.18.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
