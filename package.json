{
  "name": "lunch-time",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "setup": "./scripts/setup.sh",
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:prod": "sh -c 'set -a; . ./.env.prod; set +a; drizzle-kit migrate'",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:verify": "tsx --conditions=react-server --env-file=.env.local scripts/verify-db.mts",
    "db:seed-demo": "tsx --conditions=react-server --env-file=.env.local scripts/seed-demo.mts",
    "db:local": "./scripts/local-db.sh start",
    "db:local:stop": "./scripts/local-db.sh stop",
    "db:local:destroy": "./scripts/local-db.sh destroy"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
